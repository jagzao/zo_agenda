// Prisma Schema para Zo Agenda Multi-Tenant
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// TENANTS (Organizaciones)
// ============================================
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  plan      String   @default("free") // free, pro, enterprise
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users        User[]
  services     Service[]
  appointments Appointment[]
  availability Availability[]

  @@map("tenants")
}

// ============================================
// USERS (Multi-tenant aware)
// ============================================
model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String   @unique
  role      String   @default("customer") // admin, staff, customer
  name      String?
  phone     String?
  avatar    String?
  profile   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffAppointments      Appointment[] @relation("StaffAppointments")
  customerAppointments   Appointment[] @relation("CustomerAppointments")
  availability           Availability[]
  googleCalendarSettings GoogleCalendarSettings?

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ============================================
// SERVICES (Servicios ofrecidos)
// ============================================
model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  price           Decimal? @db.Decimal(10, 2)
  color           String?  @default("#3b82f6")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
  @@map("services")
}

// ============================================
// APPOINTMENTS (Citas)
// ============================================
model Appointment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  status     String   @default("pending") // pending, confirmed, cancelled, completed
  notes      String?
  googleEventId String? @map("google_event_id") // ID del evento en Google Calendar
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id])
  staff    User    @relation("StaffAppointments", fields: [staffId], references: [id])
  customer User    @relation("CustomerAppointments", fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([staffId])
  @@index([customerId])
  @@index([startTime])
  @@map("appointments")
}

// ============================================
// AVAILABILITY (Disponibilidad del staff)
// ============================================
model Availability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") // 0 = Sunday, 6 = Saturday
  startTime String   @map("start_time") // HH:mm format
  endTime   String   @map("end_time") // HH:mm format
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  User   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId])
  @@map("availability")
}

// ============================================
// GOOGLE CALENDAR SETTINGS (por usuario/tenant)
// ============================================
model GoogleCalendarSettings {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  accessToken  String   @map("access_token") // Encrypted
  refreshToken String   @map("refresh_token") // Encrypted
  calendarId   String   @map("calendar_id")
  syncEnabled  Boolean  @default(true) @map("sync_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_settings")
}
